{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalJSON",
  "description": "Saída da P1 — estrutura extraída do diagrama",
  "type": "object",
  "required": ["components", "relationships", "uncertainties"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["gateway", "service", "database", "queue", "cache", "load_balancer", "external", "client", "storage", "unknown"]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
